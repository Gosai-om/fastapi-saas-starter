# Copy to .env and adjust.  NEVER commit your real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Docker Compose credentials (development only)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
REDIS_URL=redis://redis:6379/0

# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON list of allowed browser origins, e.g. ["http://localhost:4200"]
CORS_ORIGINS=[]
